{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shanevcantwell/diffusiongemma-toolkit/blob/refactor/common-boundary/docs/refactor/manifest.schema.json",
  "title": "Phase A continuity schema v1",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "origin": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
