        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "blob": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "repository",
        "revision",
        "path",
        "blob"
      ],
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "properties": {
